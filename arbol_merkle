import hashlib

def calcular_sha256(dato: str | int, prefijo: bytes = b"") -> str:
    """Convierte un entero o texto a bytes y calcula su hash SHA-256."""
    bytes_dato = str(dato).encode('utf-8')
    return hashlib.sha256(prefijo + bytes_dato).hexdigest()

def construir_arbol_merkle(transacciones: list[str] | list[int]) -> str:
    """
    Construye un Árbol de Merkle a partir de una lista de únicamente 'str' o únicamente 'int'.
    """
    if not transacciones:
        return ""
    
    # 1. Crear las hojas aplicando hash a cada elemento de la lista
    nivel_actual = [calcular_sha256(tx, prefijo=b"\x00") for tx in transacciones]
    
    # 2. Reducir por niveles hasta encontrar la Raíz de Merkle
    while len(nivel_actual) > 1:
        # Si la cantidad de nodos en el nivel es impar, duplicamos el último
        if len(nivel_actual) % 2 != 0:
            nivel_actual.append(nivel_actual[-1])
            
        siguiente_nivel = []
        for i in range(0, len(nivel_actual), 2):
            combinacion = nivel_actual[i] + nivel_actual[i+1]
            hash_nodo = calcular_sha256(combinacion, prefijo=b"\x01")
            siguiente_nivel.append(hash_nodo)
            
        nivel_actual = siguiente_nivel
        
    return nivel_actual[0]


# --- Ejemplos de uso ---

# Ejemplo A: Lista únicamente de cadenas (str)
lista_textos = ["Transaccion A", "Transaccion B", "Transaccion C"]
print("Raíz (Lista de str):", construir_arbol_merkle(lista_textos))

# Ejemplo B: Lista únicamente de enteros (int)
lista_enteros = [100, 250, 500, 1200]
print("Raíz (Lista de int):", construir_arbol_merkle(lista_enteros))